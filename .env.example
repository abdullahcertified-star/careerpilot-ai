# ==========================================
# CareerPilot AI - Environment Configuration Example
# (All values are placeholders for local/dev use)
# ==========================================

# Application
APP_ENV=development
APP_NAME="CareerPilot AI"
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & Auth
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=careerpilot_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careerpilot_db

# Background Jobs & Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# AI & LLM Providers (LangChain / LangGraph)
# Placeholders: configure your provider keys safely in your private .env
OPENAI_API_KEY=placeholder_openai_api_key
ANTHROPIC_API_KEY=placeholder_anthropic_api_key
GEMINI_API_KEY=placeholder_gemini_api_key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=placeholder_langsmith_api_key
LANGSMITH_PROJECT=careerpilot-ai-dev

# Integrations & Job Board Scrapers (Optional / Placeholders)
LINKEDIN_ENABLED=false
INDEED_ENABLED=false
GREENHOUSE_ENABLED=false
LEVER_ENABLED=false
